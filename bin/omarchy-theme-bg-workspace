#!/bin/bash

# omarchy:summary=Show or set the focused workspace's own background, with workspace backgrounds on
# omarchy:args=active | current | set <path-to-picture>
# omarchy:hidden=true

case $1 in
active)
  # On, and Hyprland drawing them: the plugin is missing, or refused when it
  # was not rebuilt for the running Hyprland, and then nothing changes.
  omarchy-hyprland-toggle-enabled workspace-backgrounds &&
    hyprctl workspacebackgrounds -j 2>/dev/null | jq -e '.helper_ok == true' >/dev/null 2>&1
  ;;
current)
  # The focused workspace's picture, which is also its pick.
  hyprctl workspacebackgrounds -j | jq -r --argjson workspace "$(hyprctl activeworkspace -j | jq -r '.id')" \
    '.workspaces[] | select(.workspace == $workspace) | .path'
  ;;
set)
  if [[ -z $2 ]]; then
    echo "Usage: omarchy-theme-bg-workspace set <path-to-picture>" >&2
    exit 1
  fi

  # Kept by monitor and slot, per theme (see default/hypr/workspace-backgrounds.lua).
  # The path travels as hex, so no character in it can break out of the Lua.
  hex=$(printf '%s' "$2" | od -An -v -tx1 | tr -d ' \n')
  result=$(hyprctl eval "local p = ('$hex'):gsub('..', function(h) return string.char(tonumber(h, 16)) end); return require('default.hypr.workspace-backgrounds').pick(p)" 2>&1)
  [[ $result != *false* && $result != *rror* ]]
  ;;
*)
  echo "Usage: omarchy-theme-bg-workspace active | current | set <path-to-picture>" >&2
  exit 1
  ;;
esac
